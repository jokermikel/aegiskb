# 仅用于本地开发；生产环境请使用密钥管理服务。
DATABASE_URL=sqlite:///./aegiskb.db
JWT_SECRET=replace-this-with-a-long-random-secret
# 在阿里云百炼控制台创建。留空时仍可运行本地演示模式。
DASHSCOPE_API_KEY=
# 推荐改为你所在地域的业务空间专属域名；此默认地址仍兼容。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# none 可配合 required 强制检索；启用其他思考档位时程序会改用 tool_choice=auto。
QWEN_REASONING_EFFORT=none
# 向量检索：auto 会优先使用 DashScope embedding，未配置 Key 或上游失败时安全降级到本地确定性向量。
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
# 留空表示按 embedding 提供方采用默认阈值；生产调优后可写入 0~1 的分数。
# RETRIEVAL_MIN_SCORE=
# 混合检索：语义向量召回 + 关键词召回，经 RRF 与精确词信号轻量重排。
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_MULTIPLIER=5
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_RERANK_KEYWORD_BOOST=0.01
APP_ENV=development
