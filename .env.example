# SQLite 适合本地演示；Docker 会覆盖成 PostgreSQL。
DATABASE_URL=sqlite:///./aegiskb.db

# 本地 JWT 签名密钥。生产环境必须改为密钥管理服务中的随机值。
JWT_SECRET=replace-this-with-a-long-random-secret

# 留空时项目使用本地可测试回答；填入后启用真实千问 Agent。
DASHSCOPE_API_KEY=
# 有业务空间时建议替换为百炼控制台提供的地域专属 URL。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# none 可配合 required 强制检索；其他档位会启用思考并改用 tool_choice=auto。
QWEN_REASONING_EFFORT=none
# 单次模型请求的超时与重试上限：上游卡住时必须能及时降级，不能让请求无限期挂起。
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=1

# 向量检索：auto 表示有 Key 时用 DashScope embedding，否则用确定性的本地向量，
# 保证全新检出、无网络时也能跑通。
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
# 留空表示按 embedding 提供方使用默认阈值；语义向量与哈希向量的合适阈值并不相同。
# RETRIEVAL_MIN_SCORE=
# 混合检索：语义向量召回 + 关键词召回，经 RRF 融合与精确词信号轻量重排。
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_MULTIPLIER=5
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_RERANK_KEYWORD_BOOST=0.01

APP_ENV=development
# 是否允许启动时自动建表。开发与演示保持 true；
# 生产环境必须改为 false，并改用 `alembic upgrade head` 管理结构变更。
AUTO_CREATE_SCHEMA=true